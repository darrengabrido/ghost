// Copy this file to "Secrets.xcconfig" (same directory) and fill in real
// values. Secrets.xcconfig is gitignored — never commit real API keys.
//
//   cp Ghost/Resources/Config/Secrets.xcconfig.example Ghost/Resources/Config/Secrets.xcconfig
//
// Ghost's AI brain talks to the Anthropic Claude API — GHOST_AI_API_KEY
// should be an Anthropic API key (see console.anthropic.com).

GHOST_API_BASE_URL = https://api.anthropic.com
GHOST_AI_API_KEY = replace-with-your-anthropic-api-key
